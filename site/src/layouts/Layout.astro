---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Open strategy research for low-frequency quant trading. We share strategy rules, backtests, and real-time signals — strategy logic fully transparent.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title === 'Quant Strategy' ? title : `${title} | Quant Strategy`}</title>
    <Analytics />
  </head>
  <body class="bg-gray-950 text-gray-100 min-h-screen flex flex-col">
    <nav class="border-b border-gray-800 px-6 py-4">
      <div class="max-w-5xl mx-auto flex items-center justify-between">
        <a href="/" class="text-xl font-bold text-white tracking-tight">
          Quant Strategy
        </a>
        <div class="flex items-center gap-4 sm:gap-6 text-sm text-gray-400 flex-wrap">
          <a href="/" class="hover:text-white transition-colors" data-i18n="nav.home">Home</a>
          <a href="/strategy/btc-ma240-4d" class="hover:text-white transition-colors" data-i18n="nav.strategy">Strategy</a>
          <a href="/backtest/btc-ma240-4d" class="hover:text-white transition-colors" data-i18n="nav.backtest">Backtest</a>
          <a href="/research/btc-ma240-4d" class="hover:text-white transition-colors" data-i18n="nav.research">Research</a>
          <a href="https://github.com/xu75" class="hover:text-white transition-colors" target="_blank" rel="noopener noreferrer">GitHub</a>
          <button id="lang-toggle" class="px-2 py-1 rounded text-xs border border-gray-700 hover:border-gray-500 transition-colors" aria-label="Switch language">
            中文
          </button>
        </div>
      </div>
    </nav>

    <main class="flex-1 max-w-5xl mx-auto w-full px-6 py-8">
      <slot />
    </main>

    <footer class="border-t border-gray-800 px-6 py-6 text-center text-sm text-gray-500">
      <div class="max-w-5xl mx-auto flex flex-col gap-2">
        <p data-i18n="footer.tagline">Quant Strategy - Open strategy research for low-frequency quant trading</p>
        <div class="flex justify-center gap-4">
          <a href="/disclaimer" class="hover:text-gray-300 transition-colors" data-i18n="footer.disclaimer">Disclaimer</a>
          <a href="https://github.com/xu75" class="hover:text-gray-300 transition-colors" target="_blank" rel="noopener noreferrer" data-i18n="footer.source">GitHub</a>
        </div>
        <p class="text-gray-600" data-i18n="footer.notice">This is not investment advice. For research purposes only.</p>
      </div>
    </footer>

    <script>
      import { translations } from '../i18n/translations';

      function getLang(): string {
        return localStorage.getItem('quant-strategy-lang') || 'en';
      }

      function applyLang(lang: string) {
        const t = translations[lang];
        if (!t) return;
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n')!;
          let val = t[key];
          if (val == null) return;
          // Interpolate {placeholder} from data-i18n-<placeholder> attributes,
          // so dynamic values (symbol, percent) survive translation with
          // per-language word order.
          val = val.replace(/\{(\w+)\}/g, (_m, name) => {
            const attr = (el as HTMLElement).dataset[name];
            return attr != null ? attr : `{${name}}`;
          });
          el.textContent = val;
        });
        document.documentElement.lang = lang === 'zh' ? 'zh-CN' : 'en';
        const btn = document.getElementById('lang-toggle');
        if (btn) btn.textContent = lang === 'zh' ? 'EN' : '中文';
        localStorage.setItem('quant-strategy-lang', lang);
      }

      // Apply on load
      const lang = getLang();
      if (lang !== 'en') applyLang(lang);

      // Toggle button
      document.getElementById('lang-toggle')?.addEventListener('click', () => {
        const current = getLang();
        applyLang(current === 'en' ? 'zh' : 'en');
      });
    </script>
  </body>
</html>
