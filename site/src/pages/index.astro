---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

const strategyEntries = [
  { id: 'btc_ma_trend', href: '/strategy/btc-ma240-4d' },
  { id: 'btc_ma_trend_plus', href: '/strategy/btc-ma240-ecb2' },
  { id: 'btc_ma40d_trend', href: '/strategy/btc-ma40d-5d' },
  { id: 'echotrend_240', href: '/strategy/echotrend-240' },
];

const strategyCards = strategyEntries.flatMap(({ id, href }) => {
  const dataDir = path.resolve(process.cwd(), `../data/${id}`);
  const latestPath = path.join(dataDir, 'latest.json');
  const backtestPath = path.join(dataDir, 'backtest.json');

  if (!fs.existsSync(latestPath) || !fs.existsSync(backtestPath)) {
    return [];
  }

  const latest = JSON.parse(fs.readFileSync(latestPath, 'utf-8'));
  const backtest = JSON.parse(fs.readFileSync(backtestPath, 'utf-8'));
  const signal = latest.current_signal;
  const strategy = latest.strategy;
  const sincePerf = backtest.periods?.since_launch?.performance;
  const sinceDateIso = backtest.since_date ?? null;
  const returnPct = sincePerf?.total_return_pct ?? backtest.performance.total_return_pct;

  return [{ href, latest, signal, strategy, sinceDateIso, returnPct }];
});
---

<Layout title="Quant Strategy">
  <section class="mb-12">
    <h1 class="text-4xl font-bold mb-3">Quant Strategy</h1>
    <p class="text-lg text-gray-400 max-w-2xl" data-i18n="home.subtitle">
      Low-frequency quant research lab. We replace emotional trading with
      deterministic rules to navigate market and human uncertainty, delivering
      hands-off strategies with reliable returns and controlled drawdowns.
    </p>
    <div class="flex gap-3 mt-5">
      <a href="https://github.com/xu75/quant-strategy" target="_blank" rel="noopener noreferrer"
        class="px-4 py-2 bg-gray-800 rounded-lg text-sm hover:bg-gray-700 transition-colors" data-i18n="home.github">
        GitHub
      </a>
      <a href="/strategy/btc-ma240-4d"
        class="px-4 py-2 bg-blue-600 rounded-lg text-sm hover:bg-blue-500 transition-colors" data-i18n="home.live">
        View Live Strategy
      </a>
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-6" data-i18n="home.strategies">Strategies</h2>
    <div class="grid gap-4">
      {strategyCards.map(({ href, latest, signal, strategy, sinceDateIso, returnPct }) => (
        <a href={href} class="block">
          <div class="border border-gray-800 rounded-xl p-6 hover:border-gray-600 transition-colors">
            <div class="flex items-center justify-between mb-4">
              <div>
                <h3 class="text-lg font-semibold">{strategy.name}</h3>
                <p class="text-sm text-gray-400">{strategy.symbol} · {strategy.timeframe} · MA{strategy.ma_window}</p>
              </div>
              <span class={`px-3 py-1 rounded-full text-sm font-medium ${
                signal.action === 'hold' && latest.position.in_position
                  ? 'bg-green-900/50 text-green-400'
                  : signal.action === 'buy'
                    ? 'bg-green-900/50 text-green-400'
                    : signal.action === 'sell'
                      ? 'bg-red-900/50 text-red-400'
                      : 'bg-gray-800 text-gray-400'
              }`} data-i18n={latest.position.in_position ? 'label.in_position' : 'label.no_position'}>
                {latest.position.in_position ? 'In Position' : 'No Position'}
              </span>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
              <div>
                <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.price">Price</p>
                <p class="text-lg font-mono">${signal.price.toLocaleString()}</p>
              </div>
              <div>
                <p class="text-xs text-gray-500 uppercase tracking-wide">MA{strategy.ma_window}</p>
                <p class="text-lg font-mono">${signal.ma_value.toLocaleString()}</p>
              </div>
              <div>
                <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.return">Return (MTM)</p>
                <p class={`text-lg font-mono ${returnPct >= 0 ? 'text-green-400' : 'text-red-400'}`}>
                  {returnPct > 0 ? '+' : ''}{returnPct}%
                </p>
              </div>
              <div>
                <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.since">Since</p>
                <p class="text-lg font-mono js-local-date" data-iso={sinceDateIso ?? ''} data-fallback="—">
                  {sinceDateIso ?? '—'}
                </p>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-4" data-i18n="home.about">About</h2>
    <div class="text-gray-400 space-y-3 max-w-2xl">
      <p data-i18n="home.about.p1">
        Quant Strategy publishes open research on low-frequency quantitative
        investment strategies across crypto and traditional markets.
      </p>
      <p data-i18n="home.about.p2">
        Strategy rules, parameters, and backtesting assumptions are fully transparent.
        Every signal is generated by automated scripts running on GitHub Actions — no
        manual intervention. Anyone can reproduce the results using the published rules.
      </p>
      <p data-i18n="home.about.p3">
        This is an independent developer experiment. The site records live validation results
        to track strategy effectiveness over time. It is not investment advice.
      </p>
      <p data-i18n="home.about.p4">
        No black-box algorithms. Strategy logic and execution methodology are completely open.
      </p>
    </div>
  </section>

  <script>
    const dateFmt = new Intl.DateTimeFormat('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    });

    document.querySelectorAll('.js-local-date[data-iso]').forEach((el) => {
      const iso = el.getAttribute('data-iso');
      const fallback = el.getAttribute('data-fallback') || '—';
      if (!iso) {
        el.textContent = fallback;
        return;
      }

      const dt = new Date(iso);
      el.textContent = Number.isNaN(dt.getTime()) ? fallback : dateFmt.format(dt);
    });
  </script>
</Layout>
