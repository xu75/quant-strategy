---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

const dataDir = path.resolve(process.cwd(), '../data/btc_ma240_4d');
const latest = JSON.parse(fs.readFileSync(path.join(dataDir, 'latest.json'), 'utf-8'));
const backtest = JSON.parse(fs.readFileSync(path.join(dataDir, 'backtest.json'), 'utf-8'));

const signal = latest.current_signal;
const perf = backtest.performance;
const strategy = latest.strategy;
---

<Layout title="Home">
  <section class="mb-12">
    <h1 class="text-4xl font-bold mb-3">MeshHub</h1>
    <p class="text-lg text-gray-400 max-w-2xl">
      Open-source low-frequency quant research lab. We share strategy research,
      backtests, and real-time signal status — all free, all open source.
    </p>
    <div class="flex gap-3 mt-5">
      <a href="https://github.com/xu75/quant-strategy" target="_blank"
        class="px-4 py-2 bg-gray-800 rounded-lg text-sm hover:bg-gray-700 transition-colors">
        View Source on GitHub
      </a>
      <a href="/strategy/btc-ma240-4d"
        class="px-4 py-2 bg-blue-600 rounded-lg text-sm hover:bg-blue-500 transition-colors">
        View Live Strategy
      </a>
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-6">Strategies</h2>
    <a href="/strategy/btc-ma240-4d" class="block">
      <div class="border border-gray-800 rounded-xl p-6 hover:border-gray-600 transition-colors">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h3 class="text-lg font-semibold">{strategy.name}</h3>
            <p class="text-sm text-gray-400">{strategy.symbol} · {strategy.timeframe} · MA{strategy.ma_window}</p>
          </div>
          <span class={`px-3 py-1 rounded-full text-sm font-medium ${
            signal.action === 'hold' && latest.position.in_position
              ? 'bg-green-900/50 text-green-400'
              : signal.action === 'buy'
                ? 'bg-green-900/50 text-green-400'
                : signal.action === 'sell'
                  ? 'bg-red-900/50 text-red-400'
                  : 'bg-gray-800 text-gray-400'
          }`}>
            {latest.position.in_position ? 'In Position' : 'No Position'}
          </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          <div>
            <p class="text-xs text-gray-500 uppercase tracking-wide">Price</p>
            <p class="text-lg font-mono">${signal.price.toLocaleString()}</p>
          </div>
          <div>
            <p class="text-xs text-gray-500 uppercase tracking-wide">MA{strategy.ma_window}</p>
            <p class="text-lg font-mono">${signal.ma_value.toLocaleString()}</p>
          </div>
          <div>
            <p class="text-xs text-gray-500 uppercase tracking-wide">Return (MTM)</p>
            <p class={`text-lg font-mono ${perf.total_return_pct >= 0 ? 'text-green-400' : 'text-red-400'}`}>
              {perf.total_return_pct > 0 ? '+' : ''}{perf.total_return_pct}%
            </p>
          </div>
          <div>
            <p class="text-xs text-gray-500 uppercase tracking-wide">Max Drawdown</p>
            <p class="text-lg font-mono text-red-400">-{perf.max_drawdown_pct}%</p>
          </div>
        </div>
      </div>
    </a>
  </section>

  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">About</h2>
    <div class="text-gray-400 space-y-3 max-w-2xl">
      <p>
        MeshHub is an open-source project that researches low-frequency quantitative
        investment strategies across crypto and traditional markets.
      </p>
      <p>
        All strategy code is open source (AGPL-3.0). Every signal is generated by
        automated scripts running on GitHub Actions — no manual intervention, fully
        reproducible. Anyone can clone the repo and verify the results.
      </p>
      <p>
        This project is free and supported by community donations.
      </p>
    </div>
  </section>

  <section>
    <h2 class="text-2xl font-semibold mb-4">Support This Project</h2>
    <p class="text-gray-400 mb-4">
      MeshHub is free and open source. If you find it useful, consider supporting
      the project:
    </p>
    <div class="flex gap-3">
      <a href="https://github.com/sponsors/xu75" target="_blank"
        class="px-4 py-2 bg-gray-800 rounded-lg text-sm hover:bg-gray-700 transition-colors">
        GitHub Sponsors
      </a>
      <a href="https://buymeacoffee.com" target="_blank"
        class="px-4 py-2 bg-gray-800 rounded-lg text-sm hover:bg-gray-700 transition-colors">
        Buy Me a Coffee
      </a>
    </div>
  </section>
</Layout>
