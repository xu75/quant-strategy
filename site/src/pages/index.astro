---
import Layout from '../layouts/Layout.astro';
import { loadAllStrategies, interpolateTemplate } from '../lib/strategies';

const allStrategies = loadAllStrategies().filter(s => s.hasData);

function formatCardValue(value: any, format: string): string {
  if (value == null) return '—';
  switch (format) {
    case 'currency': return `$${Number(value).toLocaleString()}`;
    case 'percent': return `${Math.round(Number(value) * 100)}%`;
    case 'regime': return String(value);
    case 'mode': return String(value);
    case 'plain': return String(value);
    default: return String(value);
  }
}

function getCardFieldColor(value: any, format: string, isRetracted: boolean): string {
  if (isRetracted) return 'text-gray-400';
  if (value == null) return 'text-gray-300';
  if (format === 'regime') return value === 'bull' ? 'text-green-400' : value === 'bear' ? 'text-red-400' : 'text-gray-300';
  if (format === 'mode') {
    if (value === 'buy' || value === 'bull') return 'text-green-400';
    if (value === 'sell' || value === 'crash' || value === 'risk_off' || value === 'bear') return 'text-red-400';
    return 'text-gray-300';
  }
  return '';
}

const strategyCards = allStrategies.map(({ manifest, latest, backtest }) => {
  const href = `/strategy/${manifest.display.slug}`;
  const signal = latest.current_signal;
  const strategy = latest.strategy;
  const sincePerf = backtest.periods?.since_launch?.performance;
  const sinceDateIso = backtest.since_date ?? null;
  const returnPct = sincePerf?.total_return_pct ?? backtest.performance.total_return_pct;
  const status = manifest.status || 'active';
  const statusReason = manifest.status_reason || '';
  const isRetracted = status === 'retracted';
  const isDeprecated = status === 'deprecated';

  const templateVars = { ...strategy, ...manifest.config };
  const cardSubtitle = manifest.page?.card_subtitle
    ? interpolateTemplate(manifest.page.card_subtitle, templateVars)
    : manifest.display.short_desc;
  const cardFields = (manifest.page?.card_fields || []).map(field => ({
    label: interpolateTemplate(field.label, templateVars),
    value: signal[field.key],
    format: field.format,
  }));

  const gridCols = 1 + cardFields.length + 2;

  return {
    href, latest, signal, strategy, sinceDateIso, returnPct,
    status, statusReason, isRetracted, isDeprecated,
    cardSubtitle, cardFields, gridCols,
  };
});

const statusOrder = { active: 0, experimental: 0, deprecated: 1, retracted: 2 };
strategyCards.sort((a, b) => (statusOrder[a.status] ?? 0) - (statusOrder[b.status] ?? 0));

const smGridClass: Record<number, string> = {
  3: 'sm:grid-cols-3',
  4: 'sm:grid-cols-4',
  5: 'sm:grid-cols-5',
  6: 'sm:grid-cols-6',
};
---

<Layout title="Quant Strategy">
  <section class="mb-12">
    <h1 class="text-4xl font-bold mb-3">Quant Strategy</h1>
    <p class="text-lg text-gray-400 max-w-2xl" data-i18n="home.subtitle">
      Low-frequency quant research lab. We replace emotional trading with
      deterministic rules to navigate market and human uncertainty, delivering
      hands-off strategies with reliable returns and controlled drawdowns.
    </p>
    <div class="flex flex-wrap gap-3 mt-5">
      <a href="https://github.com/xu75" target="_blank" rel="noopener noreferrer"
        class="px-4 py-2 bg-gray-800 rounded-lg text-sm hover:bg-gray-700 transition-colors" data-i18n="home.github">
        GitHub
      </a>
      <a href="#strategies"
        class="px-4 py-2 bg-blue-600 rounded-lg text-sm hover:bg-blue-500 transition-colors" data-i18n="home.live">
        View Live Strategy
      </a>
      <a href="https://t.me/meshhubsignal_channel" target="_blank" rel="noopener noreferrer"
        class="px-4 py-2 bg-sky-600 rounded-lg text-sm hover:bg-sky-500 transition-colors" data-i18n="home.telegram">
        Telegram Signals
      </a>
    </div>
  </section>

  <section class="mb-12">
    <h2 id="strategies" class="text-2xl font-semibold mb-6" data-i18n="home.strategies">Strategies</h2>
    <div class="grid gap-4">
      {strategyCards.map(({ href, latest, signal, strategy, sinceDateIso, returnPct, status, statusReason, isRetracted, isDeprecated, cardSubtitle, cardFields, gridCols }) => (
        <a href={href} class="block">
          <div class={`relative overflow-hidden border rounded-xl p-6 transition-colors ${
            isRetracted ? 'retracted-card border-gray-700/70 bg-gray-900/35 hover:border-gray-600' :
            isDeprecated ? 'border-yellow-800/60 opacity-80 hover:border-yellow-700' :
            'border-gray-800 hover:border-gray-600'
          }`}>
            {isRetracted && (
              <div class="retracted-stamp pointer-events-none absolute right-5 top-5 rotate-12 rounded border-2 border-gray-500/70 px-4 py-1 text-sm font-black uppercase tracking-[0.2em] text-gray-400/90">
                Retracted
              </div>
            )}
            {(isRetracted || isDeprecated) && (
              <div class={`relative z-10 flex items-center gap-2 mb-3 text-xs font-bold uppercase ${
                isRetracted ? 'text-gray-400' : 'text-yellow-400'
              }`}>
                <span>{isRetracted ? '⊘' : '⚠'}</span>
                <span>{isRetracted ? 'Archived Snapshot' : 'DEPRECATED'}</span>
                {statusReason && <span class="font-normal text-gray-500">— {statusReason}</span>}
              </div>
            )}
            <div class={`relative z-10 flex items-center justify-between mb-4 ${isRetracted ? 'retracted-muted' : ''}`}>
              <div>
                <h3 class={`text-lg font-semibold ${isRetracted ? 'text-gray-400' : ''}`}>{strategy.name}</h3>
                <p class={`text-sm ${isRetracted ? 'text-gray-500' : 'text-gray-400'}`}>{cardSubtitle}</p>
              </div>
              <span class={`px-3 py-1 rounded-full text-sm font-medium ${
                isRetracted
                  ? 'border border-gray-700 bg-gray-800/70 text-gray-400'
                  : signal.action === 'hold' && latest.position.in_position
                  ? 'bg-green-900/50 text-green-400'
                  : signal.action === 'buy'
                    ? 'bg-green-900/50 text-green-400'
                    : signal.action === 'sell'
                      ? 'bg-red-900/50 text-red-400'
                      : 'bg-gray-800 text-gray-400'
              }`} data-i18n={latest.position.in_position ? 'label.in_position' : 'label.no_position'}>
                {isRetracted ? 'Archived Snapshot' : latest.position.in_position ? 'In Position' : 'No Position'}
              </span>
            </div>

            <div class={`relative z-10 grid grid-cols-2 ${smGridClass[gridCols] || 'sm:grid-cols-5'} gap-4 ${isRetracted ? 'retracted-muted' : ''}`}>
              <div>
                <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.price">Price</p>
                <p class={`text-lg font-mono ${isRetracted ? 'text-gray-400' : ''}`}>${signal.price.toLocaleString()}</p>
              </div>
              {cardFields.map(field => (
                <div>
                  <p class="text-xs text-gray-500 uppercase tracking-wide">{field.label}</p>
                  <p class={`text-lg font-mono capitalize ${getCardFieldColor(field.value, field.format, isRetracted)}`}>
                    {formatCardValue(field.value, field.format)}
                  </p>
                </div>
              ))}
              <div>
                <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.return">Return (MTM)</p>
                <p class={`text-lg font-mono ${isRetracted ? 'text-gray-400' : returnPct >= 0 ? 'text-green-400' : 'text-red-400'}`}>
                  {returnPct > 0 ? '+' : ''}{returnPct}%
                </p>
              </div>
              <div>
                <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.since">Since</p>
                <p class={`text-lg font-mono js-local-date ${isRetracted ? 'text-gray-400' : ''}`} data-iso={sinceDateIso ?? ''} data-fallback="—">
                  {sinceDateIso ?? '—'}
                </p>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-4" data-i18n="home.about">About</h2>
    <div class="text-gray-400 space-y-3 max-w-2xl">
      <p data-i18n="home.about.p1">
        Quant Strategy publishes open research on low-frequency quantitative
        strategies across crypto and traditional markets. Strategy logic and
        execution methodology are completely open. This is an independent developer
        experiment — the site records live validation results to track strategy
        effectiveness over time. It is not investment advice.
      </p>
      <p data-i18n="home.about.p2">
        Strategy rules, parameters, and backtesting assumptions are fully transparent.
        Every signal is generated by automated scripts running on GitHub Actions — no
        manual intervention. Anyone can reproduce the results using the published rules.
        I also run live trading to validate strategies with real results over time,
        continuously refining them. Feel free to connect and discuss.
      </p>
    </div>
    <div class="flex flex-wrap gap-3 mt-5">
      <a href="https://github.com/xu75" target="_blank" rel="noopener noreferrer"
        class="px-4 py-2 bg-gray-800 rounded-lg text-sm hover:bg-gray-700 transition-colors" data-i18n="home.about.follow">
        Follow on GitHub
      </a>
      <a href="https://t.me/meshhubsignal_channel" target="_blank" rel="noopener noreferrer"
        class="px-4 py-2 bg-sky-600 rounded-lg text-sm hover:bg-sky-500 transition-colors" data-i18n="home.telegram.join">
        Join Telegram Channel
      </a>
      <a href="https://buymeacoffee.com/jinnxu" target="_blank" rel="noopener noreferrer"
        class="px-4 py-2 bg-yellow-600 rounded-lg text-sm hover:bg-yellow-500 transition-colors" data-i18n="home.coffee">
        Buy Me a Coffee
      </a>
    </div>
  </section>

  <script>
    const dateFmt = new Intl.DateTimeFormat('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    });

    document.querySelectorAll('.js-local-date[data-iso]').forEach((el) => {
      const iso = el.getAttribute('data-iso');
      const fallback = el.getAttribute('data-fallback') || '—';
      if (!iso) {
        el.textContent = fallback;
        return;
      }

      const dt = new Date(iso);
      el.textContent = Number.isNaN(dt.getTime()) ? fallback : dateFmt.format(dt);
    });
  </script>
</Layout>
