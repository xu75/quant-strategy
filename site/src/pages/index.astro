---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

const dataDir = path.resolve(process.cwd(), '../data/btc_ma_trend');
const latest = JSON.parse(fs.readFileSync(path.join(dataDir, 'latest.json'), 'utf-8'));
const backtest = JSON.parse(fs.readFileSync(path.join(dataDir, 'backtest.json'), 'utf-8'));

const signal = latest.current_signal;
const strategy = latest.strategy;
const sincePerf = backtest.periods?.since_launch?.performance;
const sinceDate = backtest.since_date ? new Date(backtest.since_date) : null;
const sinceDateStr = sinceDate
  ? sinceDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
  : '—';
const returnPct = sincePerf?.total_return_pct ?? backtest.performance.total_return_pct;
---

<Layout title="Quant Strategy">
  <section class="mb-12">
    <h1 class="text-4xl font-bold mb-3">Quant Strategy</h1>
    <p class="text-lg text-gray-400 max-w-2xl" data-i18n="home.subtitle">
      Open-source low-frequency quant research lab. We share strategy research,
      backtests, and real-time signal status — all free, all open source.
    </p>
    <div class="flex gap-3 mt-5">
      <a href="https://github.com/xu75/quant-strategy" target="_blank" rel="noopener noreferrer"
        class="px-4 py-2 bg-gray-800 rounded-lg text-sm hover:bg-gray-700 transition-colors" data-i18n="home.github">
        View Source on GitHub
      </a>
      <a href="/strategy/btc-ma240-4d"
        class="px-4 py-2 bg-blue-600 rounded-lg text-sm hover:bg-blue-500 transition-colors" data-i18n="home.live">
        View Live Strategy
      </a>
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-6" data-i18n="home.strategies">Strategies</h2>
    <a href="/strategy/btc-ma240-4d" class="block">
      <div class="border border-gray-800 rounded-xl p-6 hover:border-gray-600 transition-colors">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h3 class="text-lg font-semibold">{strategy.name}</h3>
            <p class="text-sm text-gray-400">{strategy.symbol} · {strategy.timeframe} · MA{strategy.ma_window}</p>
          </div>
          <span class={`px-3 py-1 rounded-full text-sm font-medium ${
            signal.action === 'hold' && latest.position.in_position
              ? 'bg-green-900/50 text-green-400'
              : signal.action === 'buy'
                ? 'bg-green-900/50 text-green-400'
                : signal.action === 'sell'
                  ? 'bg-red-900/50 text-red-400'
                  : 'bg-gray-800 text-gray-400'
          }`} data-i18n={latest.position.in_position ? 'label.in_position' : 'label.no_position'}>
            {latest.position.in_position ? 'In Position' : 'No Position'}
          </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          <div>
            <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.price">Price</p>
            <p class="text-lg font-mono">${signal.price.toLocaleString()}</p>
          </div>
          <div>
            <p class="text-xs text-gray-500 uppercase tracking-wide">MA{strategy.ma_window}</p>
            <p class="text-lg font-mono">${signal.ma_value.toLocaleString()}</p>
          </div>
          <div>
            <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.return">Return (MTM)</p>
            <p class={`text-lg font-mono ${returnPct >= 0 ? 'text-green-400' : 'text-red-400'}`}>
              {returnPct > 0 ? '+' : ''}{returnPct}%
            </p>
          </div>
          <div>
            <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.since">Since</p>
            <p class="text-lg font-mono">{sinceDateStr}</p>
          </div>
        </div>
      </div>
    </a>
  </section>

  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-4" data-i18n="home.about">About</h2>
    <div class="text-gray-400 space-y-3 max-w-2xl">
      <p data-i18n="home.about.p1">
        Quant Strategy is an open-source project that researches low-frequency quantitative
        investment strategies across crypto and traditional markets.
      </p>
      <p data-i18n="home.about.p2">
        All strategy code is open source (AGPL-3.0). Every signal is generated by
        automated scripts running on GitHub Actions — no manual intervention, fully
        reproducible. Anyone can clone the repo and verify the results.
      </p>
      <p data-i18n="home.about.p3">
        This project is free and supported by community donations.
      </p>
    </div>
  </section>

  <section>
    <h2 class="text-2xl font-semibold mb-4" data-i18n="home.support">Support This Project</h2>
    <p class="text-gray-400 mb-4" data-i18n="home.support.desc">
      Quant Strategy is free and open source. If you find it useful, consider supporting
      the project:
    </p>
    <div class="flex gap-3">
      <a href="https://github.com/sponsors/xu75" target="_blank" rel="noopener noreferrer"
        class="px-4 py-2 bg-gray-800 rounded-lg text-sm hover:bg-gray-700 transition-colors" data-i18n="home.sponsor">
        GitHub Sponsors
      </a>
      <a href="https://buymeacoffee.com/jinnxu" target="_blank" rel="noopener noreferrer"
        class="px-4 py-2 bg-gray-800 rounded-lg text-sm hover:bg-gray-700 transition-colors" data-i18n="home.coffee">
        Buy Me a Coffee
      </a>
    </div>
  </section>
</Layout>
