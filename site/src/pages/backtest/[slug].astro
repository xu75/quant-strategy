---
import Layout from '../../layouts/Layout.astro';
import StrategyStatusBanner from '../../components/StrategyStatusBanner.astro';
import { loadAllStrategies } from '../../lib/strategies';

export async function getStaticPaths() {
  const strategies = loadAllStrategies();
  return strategies
    .filter(s => s.hasData)
    .map(s => ({
      params: { slug: s.manifest.display.slug },
      props: { strategyData: s },
    }));
}

const { strategyData } = Astro.props;
const { manifest, backtest } = strategyData;

const perf = backtest.performance;
const maxDrawdown = Math.abs(perf.max_drawdown_pct);
const buyHoldMaxDrawdown = Math.abs(perf.buy_hold_max_drawdown_pct);
const trades = backtest.trades;
const period = backtest.period;
const strategy = backtest.strategy;
const strategySlug = manifest.display.slug;
const hasTradeAssets = trades.some((t: any) => t.asset);
const hasTradeStatus = trades.some((t: any) => t.status);
const status = manifest.status || 'active';
const statusReason = manifest.status_reason || '';
const statusDate = manifest.status_date || '';

const subtitle = manifest.display.short_desc
  ? `${strategy.symbol} · ${manifest.display.short_desc}`
  : `${strategy.symbol} · ${strategy.timeframe} · ${manifest.name}`;
---

<Layout title={`Backtest - ${manifest.name}`} description={`Backtest results for ${manifest.name}`}>
  {(status === 'deprecated' || status === 'retracted') && (
    <StrategyStatusBanner status={status} reason={statusReason} date={statusDate} />
  )}

  <section class="mb-8">
    <div class="flex items-center gap-3 mb-2">
      <a href={`/strategy/${strategySlug}`} class="text-gray-500 hover:text-gray-300 text-sm" data-i18n="backtest.back">&larr; Strategy</a>
    </div>
    <h1 class="text-3xl font-bold mb-1" data-i18n="backtest.title">Backtest Results</h1>
    <p class="text-gray-400">
      {subtitle} ·
      <span class="js-local-date" data-iso={period.start}>{period.start}</span> —
      <span class="js-local-date" data-iso={period.end}>{period.end}</span>
    </p>
  </section>

  <section class="mb-10">
    <h2 class="text-xl font-semibold mb-4" data-i18n="backtest.perf">Performance</h2>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="border border-gray-800 rounded-lg p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.return">Return (MTM)</p>
        <p class={`text-xl font-mono ${perf.total_return_pct >= 0 ? 'text-green-400' : 'text-red-400'}`}>
          {perf.total_return_pct > 0 ? '+' : ''}{perf.total_return_pct}%
        </p>
      </div>
      <div class="border border-gray-800 rounded-lg p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="backtest.realized">Realized Return</p>
        <p class={`text-xl font-mono ${perf.realized_return_pct >= 0 ? 'text-green-400' : 'text-red-400'}`}>
          {perf.realized_return_pct > 0 ? '+' : ''}{perf.realized_return_pct}%
        </p>
      </div>
      <div class="border border-gray-800 rounded-lg p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.buyhold">Buy & Hold</p>
        <p class={`text-xl font-mono ${perf.buy_hold_return_pct >= 0 ? 'text-green-400' : 'text-red-400'}`}>
          {perf.buy_hold_return_pct > 0 ? '+' : ''}{perf.buy_hold_return_pct}%
        </p>
      </div>
      <div class="border border-gray-800 rounded-lg p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.drawdown">Max Drawdown</p>
        <p class="text-xl font-mono text-red-400">-{maxDrawdown}%</p>
      </div>
      <div class="border border-gray-800 rounded-lg p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.buyhold_drawdown">B&H Max DD</p>
        <p class="text-xl font-mono text-red-400">-{buyHoldMaxDrawdown}%</p>
      </div>
      <div class="border border-gray-800 rounded-lg p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.sharpe">Sharpe (Ann.)</p>
        <p class="text-xl font-mono">{perf.sharpe_ratio}</p>
      </div>
      <div class="border border-gray-800 rounded-lg p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.winrate">Win Rate</p>
        <p class="text-xl font-mono">{perf.win_rate_pct}%</p>
      </div>
      <div class="border border-gray-800 rounded-lg p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.trades">Total Trades</p>
        <p class="text-xl font-mono">{perf.total_trades}</p>
      </div>
      <div class="border border-gray-800 rounded-lg p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.avghold">Avg Hold</p>
        <p class="text-xl font-mono">{perf.avg_hold_bars} <span data-i18n="label.bars">bars</span></p>
      </div>
    </div>
    {perf.has_open_position && (
      <p class="text-xs text-gray-500 mt-3" data-i18n="backtest.mtm_note">* MTM return includes unrealized P&L from the current open position.</p>
    )}
  </section>

  <section class="mb-10">
    <h2 class="text-xl font-semibold mb-4" data-i18n="backtest.equity">Equity Curve</h2>
    <div class="border border-gray-800 rounded-xl p-4 bg-gray-900/50">
      <img src={`/charts/${manifest.id}/equity.png`} alt="Equity curve" class="w-full rounded" />
    </div>
  </section>

  <section class="mb-10">
    <h2 class="text-xl font-semibold mb-4" data-i18n="backtest.overlay">Price & MA Overlay</h2>
    <div class="border border-gray-800 rounded-xl p-4 bg-gray-900/50">
      <img src={`/charts/${manifest.id}/price_ma.png`} alt="Price and MA overlay with trade markers" class="w-full rounded" />
    </div>
  </section>

  <section>
    <h2 class="text-xl font-semibold mb-4" data-i18n="backtest.history">Trade History</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-800 text-gray-500 text-xs uppercase tracking-wide">
            <th class="text-left py-3 px-3" data-i18n="backtest.col.num">#</th>
            {hasTradeAssets && <th class="text-left py-3 px-3">Asset</th>}
            <th class="text-left py-3 px-3" data-i18n="backtest.col.entry">Entry</th>
            <th class="text-right py-3 px-3" data-i18n="backtest.col.entry_price">Entry Price</th>
            <th class="text-left py-3 px-3" data-i18n="backtest.col.exit">Exit</th>
            <th class="text-right py-3 px-3" data-i18n="backtest.col.exit_price">Exit Price</th>
            <th class="text-right py-3 px-3" data-i18n="backtest.col.hold">Hold</th>
            {hasTradeStatus && <th class="text-right py-3 px-3">Status</th>}
            <th class="text-right py-3 px-3" data-i18n="backtest.col.pnl">P&L</th>
          </tr>
        </thead>
        <tbody>
          {trades.map((t: any, i: number) => (
            <tr class="border-b border-gray-800/50 hover:bg-gray-900/50">
              <td class="py-3 px-3 text-gray-500">{i + 1}</td>
              {hasTradeAssets && <td class="py-3 px-3 font-mono">{t.asset || '—'}</td>}
              <td class="py-3 px-3 font-mono text-xs">
                <span class="js-local-date" data-iso={t.entry_time}>{t.entry_time}</span>
              </td>
              <td class="py-3 px-3 font-mono text-right">${t.entry_price.toLocaleString()}</td>
              <td class="py-3 px-3 font-mono text-xs">
                <span class="js-local-date" data-iso={t.exit_time}>{t.exit_time}</span>
              </td>
              <td class="py-3 px-3 font-mono text-right">${t.exit_price.toLocaleString()}</td>
              <td class="py-3 px-3 font-mono text-right">{t.hold_bars}b</td>
              {hasTradeStatus && <td class="py-3 px-3 font-mono text-right uppercase text-gray-400">{t.status || 'closed'}</td>}
              <td class={`py-3 px-3 font-mono text-right ${t.pnl_pct >= 0 ? 'text-green-400' : 'text-red-400'}`}>
                {t.pnl_pct > 0 ? '+' : ''}{t.pnl_pct}%
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <script>
    const dateFmt = new Intl.DateTimeFormat('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    });

    document.querySelectorAll('.js-local-date[data-iso]').forEach((el) => {
      const iso = el.getAttribute('data-iso');
      if (!iso) return;
      const dt = new Date(iso);
      if (!Number.isNaN(dt.getTime())) {
        el.textContent = dateFmt.format(dt);
      }
    });
  </script>
</Layout>
