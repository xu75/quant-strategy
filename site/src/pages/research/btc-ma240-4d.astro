            <th class="py-2 px-3 text-center">总收益</th>
            <th class="py-2 px-3 text-center">最大回撤</th>
            <th class="py-2 px-3 text-center">胜率</th>
            <th class="py-2 px-3 text-center">年化</th>
          </tr>
        </thead>
        <tbody>
