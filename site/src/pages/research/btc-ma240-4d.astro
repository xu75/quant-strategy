          <tr class="border-b border-gray-800"><td class="py-2 px-3 text-center">2年</td><td class="py-2 px-3 text-center">原始MA240</td><td class="py-2 px-3 text-center">21</td><td class="py-2 px-3 text-center">280.00%</td><td class="py-2 px-3 text-center">25.35%</td><td class="py-2 px-3 text-center">42.86%</td><td class="py-2 px-3 text-center">95.02%</td></tr>
