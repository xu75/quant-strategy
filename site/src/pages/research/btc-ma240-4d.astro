          <tr><td class="py-2 px-3 text-center">全周期</td><td class="py-2 px-3 text-center">跌破MA240 1%才卖</td><td class="py-2 px-3 text-center">74</td><td class="py-2 px-3 text-center">2848.20%</td><td class="py-2 px-3 text-center">62.58%</td><td class="py-2 px-3 text-center">27.03%</td><td class="py-2 px-3 text-center">57.97%</td></tr>
