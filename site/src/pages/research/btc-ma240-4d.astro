            <th class="py-2 px-3 text-center">最大回撤</th>
            <th class="py-2 px-3 text-center">胜率</th>
            <th class="py-2 px-3 text-center">持币收益率</th>
            <th class="py-2 px-3 text-center">持币回撤</th>
            <th class="py-2 px-3 text-center">年化收益率</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-gray-800"><td class="py-2 px-3 text-center">1年</td><td class="py-2 px-3 text-center">12</td><td class="py-2 px-3 text-center">58.70%</td><td class="py-2 px-3 text-center">11.03%</td><td class="py-2 px-3 text-center">25.00%</td><td class="py-2 px-3 text-center">57.35%</td><td class="py-2 px-3 text-center">30.59%</td><td class="py-2 px-3 text-center">58.70%</td></tr>
          <tr class="border-b border-gray-800"><td class="py-2 px-3 text-center">2年</td><td class="py-2 px-3 text-center">21</td><td class="py-2 px-3 text-center">296.33%</td><td class="py-2 px-3 text-center">11.03%</td><td class="py-2 px-3 text-center">42.86%</td><td class="py-2 px-3 text-center">305.09%</td><td class="py-2 px-3 text-center">30.59%</td><td class="py-2 px-3 text-center">99.08%</td></tr>
