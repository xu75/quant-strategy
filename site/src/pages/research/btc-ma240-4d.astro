          <tr class="border-b border-gray-800"><td class="py-2 px-3 text-center">3年</td><td class="py-2 px-3 text-center">原始MA240</td><td class="py-2 px-3 text-center">36</td><td class="py-2 px-3 text-center">317.42%</td><td class="py-2 px-3 text-center">29.69%</td><td class="py-2 px-3 text-center">38.89%</td><td class="py-2 px-3 text-center">61.06%</td></tr>
          <tr class="border-b border-gray-800"><td class="py-2 px-3 text-center">3年</td><td class="py-2 px-3 text-center">跌破MA240 1%才卖</td><td class="py-2 px-3 text-center">26</td><td class="py-2 px-3 text-center">322.22%</td><td class="py-2 px-3 text-center">30.90%</td><td class="py-2 px-3 text-center">30.77%</td><td class="py-2 px-3 text-center">61.68%</td></tr>
          <tr class="border-b border-gray-800"><td class="py-2 px-3 text-center">4年</td><td class="py-2 px-3 text-center">原始MA240</td><td class="py-2 px-3 text-center">48</td><td class="py-2 px-3 text-center">377.77%</td><td class="py-2 px-3 text-center">46.00%</td><td class="py-2 px-3 text-center">37.50%</td><td class="py-2 px-3 text-center">47.88%</td></tr>
