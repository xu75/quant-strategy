---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Feedback">
  <div class="max-w-2xl mx-auto">
    <h1 class="text-4xl font-bold mb-6">Feedback</h1>

    <p class="text-gray-400 mb-8">
      We'd love to hear your thoughts! Your feedback will be automatically submitted as a GitHub Issue.
      You don't need a GitHub account to submit feedback.
    </p>

    <form id="feedback-form" class="space-y-6">
      <div>
        <label for="name" class="block text-sm font-medium text-gray-300 mb-2">
          Name (optional)
        </label>
        <input
          type="text"
          id="name"
          name="name"
          class="w-full px-4 py-2 bg-gray-900 border border-gray-700 rounded-lg focus:outline-none focus:border-blue-500 text-gray-100"
          placeholder="Your name"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-gray-300 mb-2">
          Email (optional)
        </label>
        <input
          type="email"
          id="email"
          name="email"
          class="w-full px-4 py-2 bg-gray-900 border border-gray-700 rounded-lg focus:outline-none focus:border-blue-500 text-gray-100"
          placeholder="your@email.com"
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-gray-300 mb-2">
          Message <span class="text-red-400">*</span>
        </label>
        <textarea
          id="message"
          name="message"
          rows="6"
          required
          class="w-full px-4 py-2 bg-gray-900 border border-gray-700 rounded-lg focus:outline-none focus:border-blue-500 text-gray-100 resize-none"
          placeholder="Tell us what you think..."
        ></textarea>
      </div>

      <div>
        <button
          type="submit"
          class="w-full px-6 py-3 bg-blue-600 hover:bg-blue-500 rounded-lg font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          id="submit-btn"
        >
          Submit Feedback
        </button>
      </div>

      <div id="status-message" class="hidden"></div>
    </form>
  </div>
</Layout>

<script>
  const form = document.getElementById('feedback-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const statusMessage = document.getElementById('status-message') as HTMLDivElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const data = {
      name: formData.get('name') as string,
      email: formData.get('email') as string,
      message: formData.get('message') as string,
    };

    // Disable submit button
    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting...';
    statusMessage.classList.add('hidden');

    try {
      const response = await fetch('/api/feedback', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (response.ok && result.success) {
        // Success
        statusMessage.className = 'p-4 bg-green-900/50 border border-green-700 rounded-lg text-green-400';
        statusMessage.innerHTML = `
          <p class="font-medium mb-2">✓ Thank you for your feedback!</p>
          <p class="text-sm">Your feedback has been submitted as <a href="${result.issueUrl}" target="_blank" rel="noopener noreferrer" class="underline hover:text-green-300">GitHub Issue #${result.issueNumber}</a></p>
        `;
        form.reset();
      } else {
        // Error
        statusMessage.className = 'p-4 bg-red-900/50 border border-red-700 rounded-lg text-red-400';
        statusMessage.textContent = `✗ ${result.error || 'Failed to submit feedback. Please try again.'}`;
      }
    } catch (error) {
      statusMessage.className = 'p-4 bg-red-900/50 border border-red-700 rounded-lg text-red-400';
      statusMessage.textContent = '✗ Network error. Please check your connection and try again.';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Submit Feedback';
      statusMessage.classList.remove('hidden');
    }
  });
</script>
