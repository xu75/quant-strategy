---
import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

const dataDir = path.resolve(process.cwd(), '../data/echotrend_240');
const latest = JSON.parse(fs.readFileSync(path.join(dataDir, 'latest.json'), 'utf-8'));
const backtest = JSON.parse(fs.readFileSync(path.join(dataDir, 'backtest.json'), 'utf-8'));

const signal = latest.current_signal;
const position = latest.position;
const strategy = latest.strategy;
const perf = backtest.performance;
const period = backtest.period;
const periods = backtest.periods || {};

const defaultPerf = periods.since_launch?.performance || perf;
const defaultRange = periods.since_launch
  ? { start: periods.since_launch.start, end: periods.since_launch.end }
  : period;

const periodsJson = JSON.stringify(periods);
const defaultRangeJson = JSON.stringify(defaultRange);
const research = {
  title: "EchoTrend 240: BTC 4H SMA240 Regime Gate 策略研究",
  route: "/research/echotrend-240",
  canonicalUrl: "/research/echotrend-240",
  sourceProject: "https://github.com/xu75",
};
---

<Layout title="EchoTrend 240 Strategy" description="Live signal status for EchoTrend 240 (MSTR v9 Trend 4H)">
  <section class="mb-8">
    <div class="flex items-center gap-3 mb-2">
      <a href="/" class="text-gray-500 hover:text-gray-300 text-sm" data-i18n="strategy.back">&larr; Home</a>
    </div>
    <h1 class="text-3xl font-bold mb-1">{strategy.name}</h1>
    <p class="text-gray-400">{strategy.symbol} · BTC 4H SMA{strategy.ma_window} Regime Gate · {strategy.timeframe} Execution</p>
    <p class="text-xs text-gray-600 mt-2">
      <span data-i18n="strategy.updated">Last updated:</span>
      <span class="js-local-datetime" data-iso={latest.updated_at}>{latest.updated_at}</span>
    </p>
  </section>

  <section class="mb-10">
    <h2 class="text-xl font-semibold mb-4" data-i18n="strategy.signal">Current Signal</h2>
    <div class="border border-gray-800 rounded-xl p-6">
      <div class="flex items-center gap-4 mb-6">
        <span class={`px-4 py-2 rounded-full text-sm font-semibold ${
          position.in_position
            ? 'bg-green-900/50 text-green-400'
            : 'bg-gray-800 text-gray-400'
        }`} data-i18n={position.in_position ? 'label.in_position' : 'label.no_position'}>
          {position.in_position ? 'In Position' : 'No Position'}
        </span>
        <span class={`px-4 py-2 rounded-full text-sm font-semibold ${
          signal.action === 'buy' ? 'bg-green-900/50 text-green-400'
            : signal.action === 'sell' ? 'bg-red-900/50 text-red-400'
            : 'bg-gray-800 text-gray-400'
        }`}>
          <span data-i18n="strategy.signal_prefix">Signal:</span> {signal.action.toUpperCase()}
        </span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide">MSTR Price</p>
          <p class="text-xl font-mono">${signal.price.toLocaleString()}</p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide">BTC SMA{strategy.ma_window}</p>
          <p class="text-xl font-mono">${signal.ma_value.toLocaleString()}</p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="strategy.hold_bars">Hold Bars</p>
          <p class="text-xl font-mono">{signal.hold_bars ?? '—'}</p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="strategy.signal_time">Signal Time</p>
          <p class="text-sm font-mono mt-1 js-local-datetime" data-iso={signal.timestamp}>{signal.timestamp}</p>
        </div>
      </div>

      <p class="text-sm text-gray-400 mt-4">{signal.reason}</p>
    </div>
  </section>

  <section class="mb-10">
    <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
      <h2 class="text-xl font-semibold" data-i18n="strategy.perf">Performance Summary</h2>
      <div class="flex gap-1" id="period-tabs">
        {periods.since_launch && <button data-period="since_launch" class="px-3 py-1.5 rounded-lg text-sm bg-blue-600 text-white transition-colors" data-i18n="strategy.since_launch">Since Launch</button>}
        {periods['1y'] && <button data-period="1y" class="px-3 py-1.5 rounded-lg text-sm bg-gray-800 text-gray-400 hover:bg-gray-700 transition-colors">1Y</button>}
        {periods['2y'] && <button data-period="2y" class="px-3 py-1.5 rounded-lg text-sm bg-gray-800 text-gray-400 hover:bg-gray-700 transition-colors">2Y</button>}
        {periods['3y'] && <button data-period="3y" class="px-3 py-1.5 rounded-lg text-sm bg-gray-800 text-gray-400 hover:bg-gray-700 transition-colors">3Y</button>}
        {periods['5y'] && <button data-period="5y" class="px-3 py-1.5 rounded-lg text-sm bg-gray-800 text-gray-400 hover:bg-gray-700 transition-colors">5Y</button>}
      </div>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="border border-gray-800 rounded-lg p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.return">Return (MTM)</p>
        <p id="perf-return" class={`text-xl font-mono ${defaultPerf.total_return_pct >= 0 ? 'text-green-400' : 'text-red-400'}`}>
          {defaultPerf.total_return_pct > 0 ? '+' : ''}{defaultPerf.total_return_pct}%
        </p>
      </div>
      <div class="border border-gray-800 rounded-lg p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.buyhold">Buy & Hold</p>
        <p id="perf-buyhold" class={`text-xl font-mono ${defaultPerf.buy_hold_return_pct >= 0 ? 'text-green-400' : 'text-red-400'}`}>
          {defaultPerf.buy_hold_return_pct > 0 ? '+' : ''}{defaultPerf.buy_hold_return_pct}%
        </p>
      </div>
      <div class="border border-gray-800 rounded-lg p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.drawdown">Max Drawdown</p>
        <p id="perf-drawdown" class="text-xl font-mono text-red-400">-{defaultPerf.max_drawdown_pct}%</p>
      </div>
      <div class="border border-gray-800 rounded-lg p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.buyhold_drawdown">B&H Max DD</p>
        <p id="perf-buyhold-drawdown" class="text-xl font-mono text-red-400">-{defaultPerf.buy_hold_max_drawdown_pct}%</p>
      </div>
      <div class="border border-gray-800 rounded-lg p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.sharpe">Sharpe (Ann.)</p>
        <p id="perf-sharpe" class="text-xl font-mono">{defaultPerf.sharpe_ratio}</p>
      </div>
      <div class="border border-gray-800 rounded-lg p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.winrate">Win Rate</p>
        <p id="perf-winrate" class="text-xl font-mono">{defaultPerf.win_rate_pct}%</p>
      </div>
      <div class="border border-gray-800 rounded-lg p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.trades">Total Trades</p>
        <p id="perf-trades" class="text-xl font-mono">{defaultPerf.total_trades}</p>
      </div>
      <div class="border border-gray-800 rounded-lg p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.avghold">Avg Hold</p>
        <p id="perf-hold" class="text-xl font-mono"><span id="perf-hold-val">{defaultPerf.avg_hold_bars}</span> <span data-i18n="label.bars">bars</span></p>
      </div>
      <div class="border border-gray-800 rounded-lg p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.period">Period</p>
        <p id="perf-period" class="text-sm font-mono mt-1">—</p>
      </div>
    </div>
    {defaultPerf.has_open_position && (
      <p class="text-xs text-gray-500 mt-3" id="perf-open-note" data-i18n="strategy.mtm_note">* MTM return includes unrealized P&L from the current open position.</p>
    )}
  </section>

  <script define:vars={{ periodsJson, defaultRangeJson }}>
    const periods = JSON.parse(periodsJson);
    const defaultRange = JSON.parse(defaultRangeJson);
    const fmtDate = (iso) => new Date(iso).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
    const fmtDateTime = (iso) => new Date(iso).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' });

    document.querySelectorAll('.js-local-datetime[data-iso]').forEach((el) => {
      const iso = el.dataset.iso;
      if (!iso) return;
      const dt = new Date(iso);
      if (!Number.isNaN(dt.getTime())) {
        el.textContent = fmtDateTime(iso);
      }
    });

    const perfPeriodEl = document.getElementById('perf-period');
    if (perfPeriodEl && defaultRange?.start && defaultRange?.end) {
      perfPeriodEl.textContent = `${fmtDate(defaultRange.start)} — ${fmtDate(defaultRange.end)}`;
    }

    const tabs = document.getElementById('period-tabs');
    if (tabs) {
      tabs.addEventListener('click', (e) => {
        const btn = e.target.closest('button[data-period]');
        if (!btn) return;
        const key = btn.dataset.period;
        const data = periods[key];
        if (!data) return;
        const p = data.performance;

        tabs.querySelectorAll('button').forEach(b => {
          b.className = b === btn
            ? 'px-3 py-1.5 rounded-lg text-sm bg-blue-600 text-white transition-colors'
            : 'px-3 py-1.5 rounded-lg text-sm bg-gray-800 text-gray-400 hover:bg-gray-700 transition-colors';
        });

        const setVal = (id, val, suffix, colored) => {
          const el = document.getElementById(id);
          if (!el) return;
          const prefix = val > 0 ? '+' : '';
          el.textContent = colored !== false ? `${prefix}${val}${suffix}` : `${val}${suffix}`;
          if (colored !== false) {
            el.className = el.className.replace(/text-(green|red)-400/g, '');
            el.classList.add(val >= 0 ? 'text-green-400' : 'text-red-400');
          }
        };

        setVal('perf-return', p.total_return_pct, '%');
        setVal('perf-buyhold', p.buy_hold_return_pct, '%');
        document.getElementById('perf-drawdown').textContent = `-${p.max_drawdown_pct}%`;
        document.getElementById('perf-buyhold-drawdown').textContent = `-${p.buy_hold_max_drawdown_pct}%`;
        document.getElementById('perf-sharpe').textContent = p.sharpe_ratio;
        document.getElementById('perf-winrate').textContent = `${p.win_rate_pct}%`;
        document.getElementById('perf-trades').textContent = p.total_trades;
        document.getElementById('perf-hold-val').textContent = p.avg_hold_bars;

        document.getElementById('perf-period').textContent = `${fmtDate(data.start)} — ${fmtDate(data.end)}`;

        const note = document.getElementById('perf-open-note');
        if (note) note.style.display = p.has_open_position ? '' : 'none';
      });
    }
  </script>

  <section class="mb-10">
    <h2 class="text-xl font-semibold mb-4" data-i18n="strategy.rules">Strategy Rules</h2>
    <div class="border border-gray-800 rounded-xl p-6 text-gray-400 space-y-3">
      <div>
        <p class="text-white font-medium mb-1" data-i18n="strategy.et240.regime_gate">Regime Gate (BTC 4H SMA240)</p>
        <p data-i18n="strategy.et240.regime_gate_desc">BTC 1H data resampled to 4H, SMA240 computed. Bull regime when close &gt; SMA240 for 3 consecutive bars. Bear regime when close &lt; SMA240 for 3 consecutive bars. Signal shifted by 1 bar to avoid lookahead.</p>
      </div>
      <div>
        <p class="text-white font-medium mb-1" data-i18n="strategy.et240.entry">Entry (Buy MSTR)</p>
        <p data-i18n="strategy.et240.entry_desc">Regime flips from bear to bull. Full position entered on MSTR at next regular-hours bar open.</p>
      </div>
      <div>
        <p class="text-white font-medium mb-1" data-i18n="strategy.et240.exit">Exit (Sell MSTR)</p>
        <p data-i18n="strategy.et240.exit_desc">Regime flips from bull to bear (bear_ceiling=0.0). Full position exited on MSTR at next regular-hours bar open.</p>
      </div>
      <div>
        <p class="text-white font-medium mb-1" data-i18n="strategy.et240.design">Design</p>
        <p data-i18n="strategy.et240.design_desc">Binary regime gate: fully in during bull, fully out during bear. Execution at next regular-hours bar open after regime flip. No position sizing or stop loss.</p>
      </div>
    </div>
  </section>

  <section class="mb-10">
    <h2 class="text-xl font-semibold mb-4" data-i18n="strategy.research">Research Source</h2>
    <div class="border border-gray-800 rounded-xl p-6 text-gray-400 space-y-4">
      <p data-i18n="strategy.et240.research_desc">Strategy developed in mstr-strategy-clowder, validated with 4-window backtest, RD-8 parameter sensitivity, and walk-forward analysis.</p>
      <div>
        <p class="text-white font-medium mb-1">{research.title}</p>
        <div class="flex flex-wrap gap-3 text-sm">
          <a href={research.route} class="text-blue-400 hover:text-blue-300" data-i18n="strategy.et240.research_open">Read research summary</a>
          <a href={research.sourceProject} target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:text-blue-300" data-i18n="strategy.et240.research_source">Source research project</a>
        </div>
      </div>
    </div>
  </section>

  <section>
    <h2 class="text-xl font-semibold mb-4" data-i18n="strategy.datasource">Data Source</h2>
    <p class="text-gray-400 text-sm mb-2">
      BTC data from OKX public API. MSTR data from local normalized history.
      Signals are generated from dual-feed pipeline (BTC 1H → 4H regime + MSTR 1H execution).
    </p>
    <p class="text-gray-500 text-xs" data-i18n="strategy.datasource_note">
      Note: MSTR data currently relies on locally maintained CSV files. Automated updates via GitHub Actions are planned but depend on finding a suitable free data source for US equity 1H bars. BTC data (OKX) can be fetched automatically. Signal updates may lag until automation is in place.
    </p>
  </section>
</Layout>
