---
import Layout from '../../layouts/Layout.astro';
import PerformanceSummary from '../../components/PerformanceSummary.astro';
import StrategyStatusBanner from '../../components/StrategyStatusBanner.astro';
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';

const manifestPath = path.resolve(process.cwd(), '../strategies/echotrend_240/manifest.yaml');
const manifest = yaml.load(fs.readFileSync(manifestPath, 'utf-8'));
const status = manifest.status || 'active';
const statusReason = manifest.status_reason || '';
const statusDate = manifest.status_date || '';
const supersededBy = manifest.superseded_by || '';

const dataDir = path.resolve(process.cwd(), '../data/echotrend_240');
const latest = JSON.parse(fs.readFileSync(path.join(dataDir, 'latest.json'), 'utf-8'));
const backtest = JSON.parse(fs.readFileSync(path.join(dataDir, 'backtest.json'), 'utf-8'));

const signal = latest.current_signal;
const position = latest.position;
const strategy = latest.strategy;
const perf = backtest.performance;
const period = backtest.period;
const periods = backtest.periods || {};

const defaultPerf = periods.since_launch?.performance || perf;
const defaultRange = periods.since_launch
  ? { start: periods.since_launch.start, end: periods.since_launch.end }
  : period;

const sinceDateIso = backtest.since_date ?? null;
const periodsJson = JSON.stringify(periods);
const defaultRangeJson = JSON.stringify(defaultRange);
const research = {
  title: "EchoTrend 240: BTC 4H SMA240 Regime Gate 策略研究",
  route: "/research/echotrend-240",
  canonicalUrl: "/research/echotrend-240",
  sourceProject: "https://github.com/xu75",
};
---

<Layout title="EchoTrend 240 Strategy" description="Live signal status for EchoTrend 240 (MSTR v9 Trend 4H)">
  {(status === 'deprecated' || status === 'retracted') && (
    <StrategyStatusBanner status={status} reason={statusReason} date={statusDate} />
  )}
  <section class="mb-8">
    <div class="flex items-center gap-3 mb-2">
      <a href="/" class="text-gray-500 hover:text-gray-300 text-sm" data-i18n="strategy.back">&larr; Home</a>
    </div>
    <h1 class="text-3xl font-bold mb-1">{strategy.name}</h1>
    <p class="text-gray-400">{strategy.symbol} · {strategy.timeframe} Execution · BTC 4H Regime Gate + V6 Scoring</p>
    <p class="text-xs text-gray-600 mt-2">
      {sinceDateIso && <><span data-i18n="strategy.live_since">Live since:</span> <span class="js-local-date" data-iso={sinceDateIso}>{sinceDateIso}</span> · </>}
      <span data-i18n="strategy.updated">Last updated:</span>
      <span class="js-local-datetime" data-iso={latest.updated_at}>{latest.updated_at}</span>
    </p>
  </section>

  <section class="mb-10">
    <h2 class="text-xl font-semibold mb-4" data-i18n="strategy.signal">Current Signal</h2>
    <div class="border border-gray-800 rounded-xl p-6">
      <div class="flex items-center gap-4 mb-6">
        <span class={`px-4 py-2 rounded-full text-sm font-semibold ${
          position.in_position
            ? 'bg-green-900/50 text-green-400'
            : 'bg-gray-800 text-gray-400'
        }`} data-i18n={position.in_position ? 'label.in_position' : 'label.no_position'}>
          {position.in_position ? 'In Position' : 'No Position'}
        </span>
        <span class={`px-4 py-2 rounded-full text-sm font-semibold ${
          signal.action === 'buy' ? 'bg-green-900/50 text-green-400'
            : signal.action === 'sell' ? 'bg-red-900/50 text-red-400'
            : 'bg-gray-800 text-gray-400'
        }`}>
          <span data-i18n="strategy.signal_prefix">Signal:</span> {signal.action.toUpperCase()}
        </span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.price">MSTR Price</p>
          <p class="text-xl font-mono">${signal.price.toLocaleString()}</p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.exposure">Exposure</p>
          <p class="text-xl font-mono">{signal.target_exposure != null ? `${Math.round(signal.target_exposure * 100)}%` : '—'}</p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.mode">Mode</p>
          <p class={`text-xl font-mono capitalize ${
            signal.mode === 'bull' ? 'text-green-400'
              : signal.mode === 'crash' || signal.mode === 'risk_off' ? 'text-red-400'
              : 'text-gray-300'
          }`}>{signal.mode || '—'}</p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="label.regime">BTC Regime</p>
          <p class={`text-xl font-mono capitalize ${signal.regime === 'bull' ? 'text-green-400' : 'text-red-400'}`}>{signal.regime || '—'}</p>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 mt-4">
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide" data-i18n="strategy.signal_time">Signal Time</p>
          <p class="text-sm font-mono mt-1 js-local-datetime" data-iso={signal.timestamp}>{signal.timestamp}</p>
        </div>
      </div>

      <p class="text-sm text-gray-400 mt-4">{signal.reason}</p>
    </div>
  </section>

  <PerformanceSummary
    defaultPerf={defaultPerf}
    periods={periods}
    periodsJson={periodsJson}
    defaultRangeJson={defaultRangeJson}
    backtestHref="/backtest/echotrend-240"
  />

  <script>
    const fmtDateTime = (iso) => new Date(iso).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' });
    const fmtDate = (iso) => new Date(iso).toLocaleDateString('en-US', { dateStyle: 'medium' });
    document.querySelectorAll('.js-local-datetime[data-iso]').forEach((el) => {
      const iso = el.dataset.iso;
      if (!iso) return;
      const dt = new Date(iso);
      if (!Number.isNaN(dt.getTime())) {
        el.textContent = fmtDateTime(iso);
      }
    });
    document.querySelectorAll('.js-local-date[data-iso]').forEach((el) => {
      const iso = el.dataset.iso;
      if (!iso) return;
      const dt = new Date(iso);
      if (!Number.isNaN(dt.getTime())) {
        el.textContent = fmtDate(iso);
      }
    });
  </script>

  <section class="mb-10">
    <h2 class="text-xl font-semibold mb-4" data-i18n="strategy.rules">Strategy Rules</h2>
    <div class="border border-gray-800 rounded-xl p-6 text-gray-400 space-y-3">
      <div>
        <p class="text-white font-medium mb-1" data-i18n="strategy.et240.regime_gate">Regime Gate (BTC 4H SMA240)</p>
        <p data-i18n="strategy.et240.regime_gate_desc">BTC 1H data resampled to 4H, SMA240 computed. Bull regime when close &gt; SMA240 for 3 consecutive bars. Bear regime when close &lt; SMA240 for 3 consecutive bars. Signal shifted by 1 bar to avoid lookahead. Regime sets exposure ceiling: bull=1.00, bear=0.00.</p>
      </div>
      <div>
        <p class="text-white font-medium mb-1" data-i18n="strategy.et240.entry">V6 Exposure Scoring</p>
        <p data-i18n="strategy.et240.entry_desc">Three-dimensional scoring (trend + risk + relative strength) produces a continuous exposure target between 0.70 and 1.00. EMA smoothing and cooldown prevent overtrading.</p>
      </div>
      <div>
        <p class="text-white font-medium mb-1" data-i18n="strategy.et240.exit">Execution</p>
        <p data-i18n="strategy.et240.exit_desc">Symmetric rebalancing: when target exposure diverges from current by more than 3.5%, a market order is placed at next regular-hours bar open. Regime flip to bear forces exposure to 0.</p>
      </div>
      <div>
        <p class="text-white font-medium mb-1" data-i18n="strategy.et240.design">Design</p>
        <p data-i18n="strategy.et240.design_desc">Two-layer architecture: BTC regime gate (primary alpha) sets directional ceiling, V6 multi-factor scoring (trend/risk/RS) fine-tunes position size within that ceiling. Four modes (bull/neutral/risk_off/crash) apply floor/ceiling constraints. Continuous exposure management, not binary in/out.</p>
      </div>
    </div>
  </section>

  <section class="mb-10">
    <h2 class="text-xl font-semibold mb-4" data-i18n="strategy.research">Research Source</h2>
    <div class="border border-gray-800 rounded-xl p-6 text-gray-400 space-y-4">
      <p data-i18n="strategy.et240.research_desc">Strategy developed in mstr-strategy-clowder, validated with 4-window backtest, RD-8 parameter sensitivity, and walk-forward analysis.</p>
      <div>
        <p class="text-white font-medium mb-1">{research.title}</p>
        <div class="flex flex-wrap gap-3 text-sm">
          <a href={research.route} class="text-blue-400 hover:text-blue-300" data-i18n="strategy.et240.research_open">Read research summary</a>
          <a href={research.sourceProject} target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:text-blue-300" data-i18n="strategy.et240.research_source">Source research project</a>
        </div>
      </div>
    </div>
  </section>

  <section>
    <h2 class="text-xl font-semibold mb-4" data-i18n="strategy.datasource">Data Source</h2>
    <p class="text-gray-400 text-sm mb-2">
      Market data from canonical repository (data/market/): BTC-USD and MSTR 1H/1D bars, QQQ 1H/1D/5M bars.
      CI pipeline updates data via Yahoo Finance (equities) and OKX (crypto) every 4 hours.
      Signals generated from dual-feed pipeline (BTC 1H → 4H regime + MSTR 1H execution).
    </p>
    <p class="text-gray-500 text-xs" data-i18n="strategy.datasource_note">
      Note: CI runs update-data → full-backtest every 4 hours. EchoTrend 240 supports incremental daily-signal mode (state.json resume) for faster updates.
    </p>
  </section>
</Layout>
