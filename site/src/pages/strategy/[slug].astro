---
import Layout from '../../layouts/Layout.astro';
import PerformanceSummary from '../../components/PerformanceSummary.astro';
import StrategyStatusBanner from '../../components/StrategyStatusBanner.astro';
import { loadAllStrategies, interpolateTemplate } from '../../lib/strategies';

export async function getStaticPaths() {
  const strategies = loadAllStrategies();
  return strategies
    .filter(s => s.hasData)
    .map(s => ({
      params: { slug: s.manifest.display.slug },
      props: { strategyData: s },
    }));
}

const { strategyData } = Astro.props;
const { manifest, latest, backtest } = strategyData;

const signal = latest.current_signal;
const position = latest.position;
const strategy = latest.strategy;
const periods = backtest.periods || {};

const defaultPerf = periods.since_launch?.performance || backtest.performance;
const defaultRange = periods.since_launch
  ? { start: periods.since_launch.start, end: periods.since_launch.end }
  : backtest.period;

const sinceDateIso = backtest.since_date ?? null;
const periodsJson = JSON.stringify(periods);
const defaultRangeJson = JSON.stringify(defaultRange);

const status = manifest.status || 'active';
const statusReason = manifest.status_reason || '';
const statusDate = manifest.status_date || '';

const research = manifest.research ? {
  title: manifest.research.paper_title,
  route: manifest.research.website_path,
  sourceProject: manifest.research.source_project,
} : null;

const backtestHref = `/backtest/${manifest.display.slug}`;
const page = manifest.page;
const templateVars = { ...strategy, ...manifest.config };
const subtitle = page?.subtitle
  ? interpolateTemplate(page.subtitle, templateVars)
  : `${manifest.display.short_desc}`;

function formatSignalValue(value: any, format: string): string {
  if (value == null) return '—';
  switch (format) {
    case 'currency': return `$${Number(value).toLocaleString()}`;
    case 'percent': return `${Math.round(Number(value) * 100)}%`;
    case 'regime': return String(value);
    case 'mode': return String(value);
    case 'plain': return String(value);
    case 'datetime': return String(value);
    default: return String(value);
  }
}

function getSignalColor(value: any, format: string): string {
  if (value == null) return 'text-gray-300';
  if (format === 'regime') return value === 'bull' ? 'text-green-400' : 'text-red-400';
  if (format === 'mode') {
    if (value === 'bull' || value === 'risk_on') return 'text-green-400';
    if (value === 'crash' || value === 'risk_off') return 'text-red-400';
    return 'text-gray-300';
  }
  return '';
}

const signalFields = page?.signal_fields || [];
const rules = page?.rules || [];
const dataSourceDesc = page?.data_source_desc || '';

const smGridClass: Record<number, string> = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-3',
  4: 'sm:grid-cols-4',
  5: 'sm:grid-cols-5',
};
const signalGridCols = Math.min(signalFields.length, 4);
---

<Layout title={`${manifest.name} Strategy`} description={`Live signal status for ${manifest.name}`}>
  {(status === 'deprecated' || status === 'retracted') && (
    <StrategyStatusBanner status={status} reason={statusReason} date={statusDate} />
  )}

  <section class="mb-8">
    <div class="flex items-center gap-3 mb-2">
      <a href="/" class="text-gray-500 hover:text-gray-300 text-sm" data-i18n="strategy.back">&larr; Home</a>
    </div>
    <h1 class="text-3xl font-bold mb-1">{strategy.name}</h1>
    <p class="text-gray-400">{subtitle}</p>
    <p class="text-xs text-gray-600 mt-2">
      {sinceDateIso && <><span data-i18n="strategy.live_since">Live since:</span> <span class="js-local-date" data-iso={sinceDateIso}>{sinceDateIso}</span> · </>}
      <span data-i18n="strategy.updated">Last updated:</span>
      <span class="js-local-datetime" data-iso={latest.updated_at}>{latest.updated_at}</span>
    </p>
  </section>

  <section class="mb-10">
    <h2 class="text-xl font-semibold mb-4" data-i18n="strategy.signal">Current Signal</h2>
    <div class="border border-gray-800 rounded-xl p-6">
      <div class="flex items-center gap-4 mb-6">
        <span class={`px-4 py-2 rounded-full text-sm font-semibold ${
          position.in_position
            ? 'bg-green-900/50 text-green-400'
            : 'bg-gray-800 text-gray-400'
        }`} data-i18n={position.in_position ? 'label.in_position' : 'label.no_position'}>
          {position.in_position ? 'In Position' : 'No Position'}
        </span>
        <span class={`px-4 py-2 rounded-full text-sm font-semibold ${
          signal.action === 'buy' || signal.action === 'risk_on' ? 'bg-green-900/50 text-green-400'
            : signal.action === 'sell' || signal.action === 'risk_off' ? 'bg-red-900/50 text-red-400'
            : 'bg-gray-800 text-gray-400'
        }`}>
          <span data-i18n="strategy.signal_prefix">Signal:</span> {signal.action.toUpperCase()}
        </span>
      </div>

      <div class={`grid grid-cols-2 ${smGridClass[signalGridCols] || 'sm:grid-cols-4'} gap-6`}>
        {signalFields.map(field => {
          const value = signal[field.key];
          const label = interpolateTemplate(field.label, templateVars);
          const color = getSignalColor(value, field.format);
          const isDatetime = field.format === 'datetime';
          return (
            <div>
              <p class="text-xs text-gray-500 uppercase tracking-wide">{label}</p>
              {isDatetime ? (
                <p class="text-sm font-mono mt-1 js-local-datetime" data-iso={value}>{value}</p>
              ) : (
                <p class={`text-xl font-mono capitalize ${color}`}>
                  {formatSignalValue(value, field.format)}
                </p>
              )}
            </div>
          );
        })}
      </div>

      <p class="text-sm text-gray-400 mt-4">{signal.reason}</p>
    </div>
  </section>

  <PerformanceSummary
    defaultPerf={defaultPerf}
    periods={periods}
    periodsJson={periodsJson}
    defaultRangeJson={defaultRangeJson}
    backtestHref={backtestHref}
  />

  <script>
    const fmtDateTime = (iso) => new Date(iso).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' });
    const fmtDate = (iso) => new Date(iso).toLocaleDateString('en-US', { dateStyle: 'medium' });
    document.querySelectorAll('.js-local-datetime[data-iso]').forEach((el) => {
      const iso = el.dataset.iso;
      if (!iso) return;
      const dt = new Date(iso);
      if (!Number.isNaN(dt.getTime())) el.textContent = fmtDateTime(iso);
    });
    document.querySelectorAll('.js-local-date[data-iso]').forEach((el) => {
      const iso = el.dataset.iso;
      if (!iso) return;
      const dt = new Date(iso);
      if (!Number.isNaN(dt.getTime())) el.textContent = fmtDate(iso);
    });
  </script>

  {rules.length > 0 && (
    <section class="mb-10">
      <h2 class="text-xl font-semibold mb-4" data-i18n="strategy.rules">Strategy Rules</h2>
      <div class="border border-gray-800 rounded-xl p-6 text-gray-400 space-y-3">
        {rules.map(rule => (
          <div>
            <p class="text-white font-medium mb-1">{rule.title}</p>
            <p>{rule.description}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {research && (
    <section class="mb-10">
      <h2 class="text-xl font-semibold mb-4" data-i18n="strategy.research">Research Source</h2>
      <div class="border border-gray-800 rounded-xl p-6 text-gray-400 space-y-4">
        <p>Every live strategy must have a versioned research memo and a public summary page.</p>
        <div>
          <p class="text-white font-medium mb-1">{research.title}</p>
          <div class="flex flex-wrap gap-3 text-sm">
            <a href={research.route} class="text-blue-400 hover:text-blue-300" data-i18n="strategy.research_open">Read summary on this site</a>
            {research.sourceProject && (
              <a href={research.sourceProject} target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:text-blue-300">Source research project</a>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  {dataSourceDesc && (
    <section>
      <h2 class="text-xl font-semibold mb-4" data-i18n="strategy.datasource">Data Source</h2>
      <p class="text-gray-400 text-sm">{dataSourceDesc}</p>
    </section>
  )}
</Layout>
